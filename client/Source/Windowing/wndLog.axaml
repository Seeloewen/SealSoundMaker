<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="SealSoundMaker.Source.Windowing.wndLog"
        Title="" ExtendClientAreaToDecorationsHint="True" Width="800" Height="450">
    <Grid Name="grdMain" Background="#404040" >
        <Grid x:Name="grdTop"  Height="50" VerticalAlignment="Top" Background="#292929" PointerPressed="Grid_PointerPressed">
            <TextBlock x:Name="tblHeader"  FontSize="26" FontWeight="DemiBold" Margin="15,10,0,0" Foreground="White">Log</TextBlock>
            <Button HorizontalAlignment="Right" Margin="0,0,200,0">Clear</Button>        
</Grid>
        <SelectableTextBlock Name="stbLog" Margin="15,60,0,0">
            <SelectableTextBlock.Inlines>
            </SelectableTextBlock.Inlines>
        </SelectableTextBlock>
    </Grid>
</Window>
